# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API Keys / Data API).

# URL do projeto, ex.: https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública do projeto: a "Publishable key" (começa com sb_publishable_...)
# ou a chave "anon" antiga. NUNCA use a chave secreta/service_role aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ATENÇÃO: o acesso de administração (aplicar migrations, gerar tipos) NÃO vai neste
# arquivo. Fica num arquivo separado, ".env.supabase", também fora do git:
#   SUPABASE_ACCESS_TOKEN=sbp_...      (Supabase → Account → Access Tokens)
#   SUPABASE_PROJECT_REF=abcdefghijk   (trecho antes de .supabase.co na URL)
