# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API Keys / Data API).

# URL do projeto, ex.: https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública do projeto: a "Publishable key" (começa com sb_publishable_...)
# ou a chave "anon" antiga. NUNCA use a chave secreta/service_role aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
